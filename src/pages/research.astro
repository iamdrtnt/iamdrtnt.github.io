---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import PublicationCard from "../components/Publication.astro";
import Icon from "../components/Icon.astro";
import {
  profile,
  publications,
  projects,
  presentations,
} from "../data/profile";
const academic = profile.profiles.filter((p) =>
  ["ORCID", "Google Scholar", "ResearchGate", "PubMed"].includes(p.label),
);
---

<Base
  title="Research and Publications | Mohammadreza Norouzi"
  description="Browse Mohammadreza Norouzi’s research interests in clinical medicine, neuroscience, artificial intelligence in healthcare, and evidence-based medicine."
  label="Research"
>
  <PageHead
    title="Publications & Research"
    parent="Exploring Questions. Advancing Understanding."
    description={"My academic interests focus on clinical research, evidence-based medicine, and emerging applications of artificial intelligence in healthcare. This section presents verified scholarly publications and selected research activities, reflecting my commitment to scientific inquiry and critical thinking. My broader interests also extend to neuroscience, particularly understanding the complexity and function of the human brain."}
  />
  <div class="wrap section">
    <h2>Research interests</h2>
    <div class="card-grid spaced">
      {profile.research.map((r) => (
        <section
          class="interest-card"
          id={r.title.toLowerCase().replaceAll(" ", "-")}
        >
          <span class="iconblock">
            <Icon name={r.icon} size={24} />
          </span>
          <h3>{r.title}</h3>
          <p>{r.description}</p>
        </section>
      ))}
    </div>
  </div>
  <div class="tint">
    <div class="wrap section dossier">
      <section id="publications">
        <h2>Publications</h2>
        <div>
          {publications.length ? (
            publications.map((record) => <PublicationCard record={record} />)
          ) : (
            <div class="empty">
              <Icon name="book" />
              <h3>Publications coming soon</h3>
              <p>
                Verified citations and links will appear here as they become
                available.
              </p>
            </div>
          )}
        </div>
      </section>
      <section>
        <h2>Research projects</h2>
        <div>
          {projects.length ? (
            projects.map((p) => (
              <article>
                <h3>{p.title}</h3>
                <p>{p.description}</p>
                {p.url && <a href={p.url}>Project details</a>}
              </article>
            ))
          ) : (
            <p>
              Project descriptions will be added when details are available for
              public sharing.
            </p>
          )}
        </div>
      </section>
      <section>
        <h2>Conference presentations</h2>
        <div>
          {presentations.length ? (
            presentations.map((p) => (
              <p>
                <strong>{p.title}</strong> · {p.meeting}, {p.year}
              </p>
            ))
          ) : (
            <p>No verified conference records are listed.</p>
          )}
        </div>
      </section>
      <section>
        <h2>Scientific activities</h2>
        <p>
          My interests span clinical research, evidence-based medicine, and the application of artificial intelligence in healthcare. I am particularly fascinated by the human brain, its complex functions, and the questions that remain unanswered about how it works. My <a href="/blog/">blog</a> explores the methods and
          questions behind these interests.
        </p>
      </section>
      <section>
        <h2>Academic profiles</h2>
        <div>
          {academic.length ? (
            academic.map((p) => (
              <p>
                <a href={p.url}>{p.label}</a>
              </p>
            ))
          ) : (
            <p>Academic profile links will be added once verified.</p>
          )}
        </div>
      </section>
    </div>
  </div>
</Base>
