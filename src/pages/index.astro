---
import Base from "../layouts/Base.astro";
import Plate from "../components/Plate.astro";
import Icon from "../components/Icon.astro";
import SectionTitle from "../components/SectionTitle.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { profile, projects, publications } from "../data/profile";
import { articles } from "../lib/articles";
const latest = (await articles()).slice(0, 3);
---

<Base
  title="Mohammadreza Norouzi | Medical Graduate and Research Portfolio"
  description="Explore Mohammadreza Norouzi’s medical education, research interests, scientific writing, and professional background in Vancouver, British Columbia."
  type="ProfilePage"
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">
          <span></span>Academic portfolio
        </p>
        <h1>
          Mohammadreza <em>Norouzi</em>
        </h1>
        <p class="descriptor">
          MD Graduate <i></i> Clinical Research <i></i> Healthcare Innovation
        </p>
        <p class="hero-intro">{profile.introduction}</p>
        <div class="actions">
          <a class="button mint" href="/about/">
            About Me <Icon name="arrow" size={17} />
          </a>
          <a class="button ghost" href="/research/">
            Explore Research <Icon name="diagonal" size={16} />
          </a>
        </div>
      </div>
      <Plate />
    </div>
  </section>
  <div class="identity">
    <div class="wrap facts">
      <span>
        <Icon name="pin" />
        Vancouver, BC, Canada
      </span>
      <span>
        <Icon name="cap" />
        Doctor of Medicine
      </span>
      <span>
        <Icon name="book" />
        Scientific writing
      </span>
    </div>
  </div>
  <section class="wrap section">
    <SectionTitle
      label="Research interests"
      title="Areas of inquiry"
      link="Research portfolio"
      href="/research/"
    />
    <div class="card-grid">
      {profile.research.slice(0, 3).map((r, i) => (
        <a
          class="interest-card"
          href={
            "/research/#" +
            ["clinical-research", "neuroscience", "ai-in-healthcare"][i]
          }
        >
          <div class="card-top">
            <span class="iconblock">
              <Icon name={r.icon} size={24} />
            </span>
            <Icon name="diagonal" size={16} />
          </div>
          <h3>{r.title}</h3>
          <p>{r.description}</p>
        </a>
      ))}
    </div>
    <div class="research-record">
      <div>
        <span class="kicker">Featured research</span>
        <p>
          {projects[0]?.title ||
            publications[0]?.title ||
            "Project and publication records will appear here once verified."}
        </p>
      </div>
      <a class="textlink" href="/research/#publications">
        Publications <Icon name="arrow" size={16} />
      </a>
    </div>
  </section>
  <section class="tint">
    <div class="wrap section split">
      <div>
        <p class="eyebrow">
          <span></span>About me
        </p>
        <h2>
          From clinical practice
          <br />
          to research.
        </h2>
        <p class="prose-intro">{profile.bio}</p>
        <a class="textlink" href="/about/">
          Read my biography <Icon name="arrow" size={17} />
        </a>
        <h3 class="skills-title">Professional skills</h3>
        <div class="tags">
          {profile.skills.map((s) => (
            <span>{s}</span>
          ))}
        </div>
      </div>
      <div class="summary-list">
        <h3>Academic background</h3>
        {profile.education.map((e) => (
          <div>
            <span class="kicker">{e.place}</span>
            <h4>{e.title}</h4>
            <p>{e.institution}</p>
          </div>
        ))}
        <a class="textlink" href="/experience/">
          Education and experience <Icon name="arrow" size={16} />
        </a>
      </div>
    </div>
  </section>
  <section class="wrap section">
    <SectionTitle
      label="Scientific writing"
      title="Latest articles"
      link="Visit the blog"
      href="/blog/"
    />
    <div class="card-grid">
      {latest.map((post) => (
        <ArticleCard post={post} />
      ))}
    </div>
  </section>
  <section class="wrap contact-band">
    <div>
      <p class="eyebrow">
        <span></span>Contact
      </p>
      <h2>Connect professionally</h2>
      <p>
        Professional profiles and contact information for research and academic
        enquiries.
      </p>
    </div>
    <a class="button mint" href="/contact/">
      Contact details <Icon name="arrow" size={16} />
    </a>
  </section>
</Base>
