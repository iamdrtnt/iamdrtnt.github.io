---
import Base from "../layouts/Base.astro";
import StethoscopeSequence from "../components/StethoscopeSequence.astro";
import Icon from "../components/Icon.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { profile, projects, publications } from "../data/profile";
import { articles } from "../lib/articles";
import "../styles/home.css";
const latest = (await articles()).slice(0, 3);
const directions = [
  {
    title: "Medicine",
    href: "/experience/",
    detail: "Working in primary healthcare taught me to assess complex clinical situations, make high-stakes decisions under pressure, and coordinate healthcare teams in demanding environments.",
  },
  {
    title: "Research",
    href: "/research/",
    detail: "For me, research begins with curiosity: questioning what we know, exploring what we do not yet understand, and seeking meaningful answers through scientific inquiry.",
  },
  {
    title: "Innovation",
    href: "/research/#healthcare-innovation",
    detail: "Building on my medical background and Executive Healthcare MBA education, I am interested in exploring how healthcare management, entrepreneurship, and digital technologies can address systemic challenges and create more accessible, efficient, and equitable healthcare services.",
  },
];
---

<Base
  title="Mohammadreza Norouzi | Medical Graduate and Research Portfolio"
  description="Explore Mohammadreza Norouzi’s medical education, research interests, scientific writing, and professional background in Vancouver, British Columbia."
  type="ProfilePage"
>
  <StethoscopeSequence />
  <section class="trajectory" id="portfolio" tabindex="-1">
    <div class="wrap trajectory-grid">
      <div>
        <p class="overline">
          <i></i> Clinical perspective
        </p>
        <p class="trajectory-intro">{profile.introduction}</p>
      </div>
      <div class="directions">
        {directions.map(({ title, href, detail }) => (
          <a href={href}>
            <h2>{title}</h2>
            <p>{detail}</p>
            <Icon name="diagonal" size={20} />
          </a>
        ))}
      </div>
    </div>
  </section>
  <section class="paper-scene">
    <div class="wrap home-section">
      <div class="chapter-line">
        <span>About me</span>
        <span>Biography &amp; education</span>
      </div>
      <div class="bio-spread">
        <div>
          <h2 class="display">
            From Clinical Practice <em>to New Perspectives</em>
          </h2>
          <p class="bio-text">{profile.bio}</p>
          <p class="disclosure">{profile.disclosure}</p>
          <a class="textlink" href="/about/">
            Read my biography <Icon name="arrow" size={17} />
          </a>
        </div>
        <div class="education">
          {profile.portrait && (
            <img class="owner-portrait" {...profile.portrait} loading="lazy" />
          )}
          <h3 class="small-label">Academic background</h3>
          {profile.education.map((e) => (
            <div class="degree">
              <h4>{e.title}</h4>
              <p>
                {e.institution}, {e.place}
              </p>
            </div>
          ))}
          <a class="textlink" href="/experience/">
            Education and experience <Icon name="diagonal" size={15} />
          </a>
          <h3 class="small-label skills-heading">Professional skills</h3>
          <ul class="skill-list">
            {profile.skills.map((s) => (
              <li>{s}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>
  <section class="research-scene">
    <div class="wrap home-section">
      <div class="chapter-line">
        <span>Research &amp; publications</span>
        <span>Research interests</span>
      </div>
      <div class="research-spread">
        <div>
          <span class="section-number" style="visibility: hidden" aria-hidden="true">
            05
          </span>
          <h2 class="display">
            Areas of <em>inquiry.</em>
          </h2>
          <a class="textlink" href="/research/">
            Research portfolio <Icon name="arrow" size={17} />
          </a>
        </div>
        <div class="research-index">
          {profile.research.slice(0, 3).map((r) => (
            <a
              href={"/research/#" + r.title.toLowerCase().replaceAll(" ", "-")}
            >
              <div>
                <h3>{r.title}</h3>
                <p>{r.description}</p>
              </div>
              <Icon name="diagonal" size={20} />
            </a>
          ))}
          <div class="publication-note">
            <a class="textlink" href="/research/#publications">
              Publications <Icon name="arrow" size={16} />
            </a>
            <p>
              {projects[0]?.title ||
                publications[0]?.title ||
                "Project and publication records will appear here once verified."}
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="paper-scene">
    <div class="wrap home-section">
      <div class="chapter-line">
        <span>Scientific writing</span>
        <span>Latest articles</span>
      </div>
      <div class="journal-head">
        <h2 class="display">
          The <em>journal.</em>
        </h2>
        <a class="textlink" href="/blog/">
          Visit the blog <Icon name="arrow" size={17} />
        </a>
      </div>
      <div class="journal-spread">
        {latest.map((post) => (
          <ArticleCard post={post} />
        ))}
      </div>
    </div>
  </section>
  <section class="closing">
    <div class="wrap home-section">
      <p class="overline">
        <i></i> Contact
      </p>
      <div class="closing-grid">
        <h2 class="display">
          Connect <em>professionally.</em>
        </h2>
        <div>
          <p>
            Professional profiles and contact information for research and
            academic enquiries.
          </p>
          <div class="hero-actions">
            <a class="button ivory" href="/contact/">
              Contact details <Icon name="arrow" size={16} />
            </a>
            {profile.profiles.map((p) => (
              <a class="quiet-link" href={p.url} rel="me">
                {p.label} <Icon name="diagonal" size={14} />
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
