---
import Base from "../layouts/Base.astro";
import StethoscopeSequence from "../components/StethoscopeSequence.astro";
import Icon from "../components/Icon.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { projects, publications } from "../data/profile";
import { articles } from "../lib/articles";
import "../styles/home.css";
import { localeFromPath, translator, localPath } from "../i18n/locales";
import { profileFor } from "../i18n/profile";

const locale = localeFromPath(Astro.url.pathname);
const t = translator(locale);
const route = (path: string) => localPath(path, locale);
const profile = profileFor(locale);

const latest = (await articles(locale)).slice(0, 3);
const directions = [
  {
    title: t("Medicine", "پزشکی"),
    href: "/experience/",
    detail: t("Working in primary healthcare taught me to assess complex clinical situations, make high-stakes decisions under pressure, and coordinate healthcare teams in demanding environments.", "کار در مراقبت‌های اولیهٔ سلامت به من آموخت وضعیت‌های بالینی پیچیده را ارزیابی کنم، در شرایط دشوار تصمیم‌های حساس بگیرم و تیم‌های درمانی را هماهنگ کنم."),
  },
  {
    title: t("Research", "پژوهش"),
    href: "/research/",
    detail: t("For me, research begins with curiosity: questioning what we know, exploring what we do not yet understand, and seeking meaningful answers through scientific inquiry.", "برای من پژوهش با کنجکاوی آغاز می‌شود: دانسته‌ها را به پرسش می‌کشیم، نادانسته‌ها را بررسی می‌کنیم و با روش علمی به دنبال پاسخ‌های روشنگر می‌گردیم."),
  },
  {
    title: t("Innovation", "نوآوری"),
    href: "/research/#healthcare-innovation",
    detail: t("Building on my medical background and Executive Healthcare MBA education, I am interested in exploring how healthcare management, entrepreneurship, and digital technologies can address systemic challenges and create more accessible, efficient, and equitable healthcare services.", "با تکیه بر پیشینهٔ پزشکی و آموزش مدیریت اجرایی در سلامت، می‌خواهم بررسی کنم که مدیریت سلامت، کارآفرینی و فناوری‌های دیجیتال چگونه می‌توانند به حل چالش‌های ساختاری و ارائهٔ خدمات سلامتِ دسترس‌پذیرتر، کارآمدتر و عادلانه‌تر کمک کنند."),
  },
];
---

<Base
  title={t("Mohammadreza Norouzi | Medical Graduate and Research Portfolio", "محمدرضا نوروزی | دانش‌آموختهٔ پزشکی و سوابق پژوهشی")}
  description={t("Explore Mohammadreza Norouzi’s medical education, research interests, scientific writing, and professional background in Vancouver, British Columbia.", "با تحصیلات پزشکی، علایق پژوهشی، نوشته‌های علمی و سوابق حرفه‌ای محمدرضا نوروزی در ونکوور، بریتیش کلمبیا آشنا شوید.")}
  type="ProfilePage"
>
  <StethoscopeSequence />
  <section class="trajectory" id="portfolio" tabindex="-1">
    <div class="wrap trajectory-grid">
      <div>
        <p class="overline">
          <i></i> {t("Clinical perspective", "دیدگاه بالینی")}
        </p>
        <p class="trajectory-intro">{profile.introduction}</p>
      </div>
      <div class="directions">
        {directions.map(({ title, href, detail }) => (
          <a href={route(href)}>
            <h2>{title}</h2>
            <p>{detail}</p>
            <Icon name="diagonal" size={20} />
          </a>
        ))}
      </div>
    </div>
  </section>
  <section class="paper-scene">
    <div class="wrap home-section">
      <div class="chapter-line">
        <span>{t("About me", "دربارهٔ من")}</span>
        <span>{t("Biography & education", "زندگی‌نامه و تحصیلات")}</span>
      </div>
      <div class="bio-spread">
        <div>
          <h2 class="display">
            {t("From Clinical Practice", "از طبابت بالینی")} <em>{t("to New Perspectives", "تا دیدگاه‌های تازه")}</em>
          </h2>
          <p class="bio-text">{profile.bio}</p>
          <p class="disclosure">{profile.disclosure}</p>
          <a class="textlink" href={route("/about/")}>
            {t("Read my biography", "زندگی‌نامهٔ من را بخوانید")} <Icon name="arrow" size={17} />
          </a>
        </div>
        <div class="education">
          {profile.portrait && (
            <img class="owner-portrait" {...profile.portrait} loading="lazy" />
          )}
          <h3 class="small-label">{t("Academic background", "سوابق تحصیلی")}</h3>
          {profile.education.map((e) => (
            <div class="degree">
              <h4>{e.title}</h4>
              <p>
                {e.institution}, {e.place}
              </p>
            </div>
          ))}
          <a class="textlink" href={route("/experience/")}>
            {t("Education and experience", "تحصیلات و سوابق")} <Icon name="diagonal" size={15} />
          </a>
          <h3 class="small-label skills-heading">{t("Professional skills", "مهارت‌های حرفه‌ای")}</h3>
          <ul class="skill-list">
            {profile.skills.map((s) => (
              <li>{s}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>
  <section class="research-scene">
    <div class="wrap home-section">
      <div class="chapter-line">
        <span>{t("Research & publications", "پژوهش و آثار علمی")}</span>
        <span>{t("Research interests", "علایق پژوهشی")}</span>
      </div>
      <div class="research-spread">
        <div>
          <span class="section-number" style="visibility: hidden" aria-hidden="true">
            05
          </span>
          <h2 class="display">
            {t("Areas of", "زمینه‌های")} <em>{t("inquiry.", "پژوهش")}</em>
          </h2>
          <a class="textlink" href={route("/research/")}>
            {t("Research portfolio", "سوابق پژوهشی")} <Icon name="arrow" size={17} />
          </a>
        </div>
        <div class="research-index">
          {profile.research.slice(0, 3).map((r) => (
            <a
              href={route("/research/#" + r.id)}
            >
              <div>
                <h3>{r.title}</h3>
                <p>{r.description}</p>
              </div>
              <Icon name="diagonal" size={20} />
            </a>
          ))}
          <div class="publication-note">
            <a class="textlink" href={route("/research/#publications")}>
              {t("Publications", "آثار علمی")} <Icon name="arrow" size={16} />
            </a>
            <p>
              {projects[0]?.title ||
                publications[0]?.title ||
                t("Project and publication records will appear here once verified.", "سوابق طرح‌ها و آثار علمی پس از تأیید در این بخش قرار می‌گیرند.")}
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="paper-scene">
    <div class="wrap home-section">
      <div class="chapter-line">
        <span>{t("Scientific writing", "نگارش علمی")}</span>
        <span>{t("Latest articles", "تازه‌ترین مقاله‌ها")}</span>
      </div>
      <div class="journal-head">
        <h2 class="display">
          {t("The", "")} <em>{t("journal.", "مجله")}</em>
        </h2>
        <a class="textlink" href={route("/blog/")}>
          {t("Visit the blog", "رفتن به مجله")} <Icon name="arrow" size={17} />
        </a>
      </div>
      <div class="journal-spread">
        {latest.map((post) => (
          <ArticleCard post={post} />
        ))}
      </div>
    </div>
  </section>
  <section class="closing">
    <div class="wrap home-section">
      <p class="overline">
        <i></i> {t("Contact", "تماس")}
      </p>
      <div class="closing-grid">
        <h2 class="display">
          {t("Connect", "ارتباط")} <em>{t("professionally.", "حرفه‌ای")}</em>
        </h2>
        <div>
          <p>
            {t("Professional profiles and contact information for research and academic enquiries.", "نمایه‌های حرفه‌ای و اطلاعات تماس برای گفت‌وگوهای پژوهشی و دانشگاهی.")}
          </p>
          <div class="hero-actions">
            <a class="button ivory" href={route("/contact/")}>
              {t("Contact details", "اطلاعات تماس")} <Icon name="arrow" size={16} />
            </a>
            {profile.profiles.map((p) => (
              <a class="quiet-link" href={p.url} rel="me">
                {p.label} <Icon name="diagonal" size={14} />
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
