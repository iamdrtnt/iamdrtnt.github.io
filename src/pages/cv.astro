---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import Icon from "../components/Icon.astro";
import PublicationCard from "../components/Publication.astro";
import { profile, achievements, publications } from "../data/profile";
---

<Base
  title="Curriculum Vitae | Mohammadreza Norouzi"
  description="View Mohammadreza Norouzi’s online CV, including education, medical and research experience, scientific writing, and professional interests."
  label="Curriculum vitae"
>
  <PageHead
    title="Curriculum vitae"
    description={profile.title}
    parent={profile.location}
  />
  <div class="wrap section dossier">
    <div class="cv-download">
      {profile.cvPath ? (
        <a class="button primary" href={profile.cvPath} download>
          <Icon name="file" />
          Download CV
        </a>
      ) : (
        <span class="pdf">
          <Icon name="file" />
          CV download · PDF available soon
        </span>
      )}
    </div>
    <section>
      <h2>Professional summary</h2>
      <div>
        <p>{profile.summary}</p>
        <p class="note">{profile.disclosure}</p>
      </div>
    </section>
    <section>
      <h2>Education</h2>
      <div>
        {profile.education
          .map((e) => (
            <div>
              <h3>{e.title}</h3>
              <p>
                {e.institution}, {e.place}
              </p>
            </div>
          ))}
      </div>
    </section>
    <section>
      <h2>Professional experience</h2>
      <div>
        {profile.experience.map((e) => (
          <div>
            <h3>{e.title} | {e.date}</h3>
            <p>{e.place}</p>
          </div>
        ))}
      </div>
    </section>
    <section>
      <h2>Professional areas</h2>
      <p>Strategic Thinking · Healthcare Management · Problem-Solving · Leadership & Team Coordination · Digital Health · Entrepreneurship</p>
    </section>
    <section>
      <h2>Publications</h2>
      <div>
        {publications.length ? (
          publications.map((record) => <PublicationCard record={record} />)
        ) : (
          <a href="/research/">
            View publication status in the research portfolio
          </a>
        )}
      </div>
    </section>
    <section>
      <h2>Certifications</h2>
      <div>
        {profile.training.map((name) => <p>{name}</p>)}
      </div>
    </section>
    <section>
      <h2>Entrepreneurship</h2>
      <div>
        {achievements.length ? (
          <ul>
            {achievements.map((a) => (
              <li>{a}</li>
            ))}
          </ul>
        ) : (
          <p>No additional academic distinctions are listed.</p>
        )}
      </div>
    </section>
    <section>
      <h2>Clinical competencies</h2>
      <div class="tags">
        {profile.skills.map((s) => (
          <span>{s}</span>
        ))}
      </div>
    </section>
    <section>
      <h2>Professional interests</h2>
      <div class="tags">
        {profile.interests.map((r) => (
          <span>{r}</span>
        ))}
      </div>
    </section>
  </div>
</Base>
