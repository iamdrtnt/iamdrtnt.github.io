---
import { render, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import JournalCover from "../../components/JournalCover.astro";
import JournalEntry from "../../components/JournalEntry.astro";
import { profile } from "../../data/profile";
import { articles, articleUrl, dateLabel, readingTime } from "../../lib/articles";
import "../../styles/journal.css";

export async function getStaticPaths() {
  const posts = await articles();
  return posts.map((post, index) => ({
    params: { id: post.id },
    props: { post, posts, index },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
  posts: CollectionEntry<"blog">[];
  index: number;
}

const { post, posts, index } = Astro.props;
const { Content, headings } = await render(post);
const p = post.data;
const url = new URL(articleUrl(post.id), Astro.site).href;
const newer = posts[index - 1];
const older = posts[index + 1];
const related = posts
  .filter(({ id }) => id !== post.id && id !== newer?.id && id !== older?.id)
  .map((entry) => ({
    entry,
    sharedCategory: Number(entry.data.category === p.category),
    sharedTags: entry.data.tags.filter((tag) => p.tags.includes(tag)).length,
  }))
  .filter(({ sharedCategory, sharedTags }) => sharedCategory || sharedTags)
  .sort((a, b) => b.sharedCategory - a.sharedCategory || b.sharedTags - a.sharedTags)
  .slice(0, 2);
const sections = headings.filter((h) => h.depth === 2);
const schema = {
  headline: p.title,
  author: { "@id": new URL("/#person", Astro.site).href },
  datePublished: p.publishDate.toISOString(),
  articleSection: p.category,
  keywords: p.tags,
  image: new URL(p.coverImage?.src ?? "/images/social-card.png", Astro.site).href,
  mainEntityOfPage: url,
};
---

<Base
  title={`${p.seoTitle ?? p.title} | ${profile.name}`}
  description={p.seoDescription ?? p.description}
  label={p.title}
  type="BlogPosting"
  extraSchema={schema}
  date={p.publishDate}
  image={p.coverImage?.src}
  imageAlt={p.coverImage?.alt}
>
  <div class="journal">
    <article>
      <header class="journal-masthead journal-article-head">
        <div class="journal-wrap">
          <a class="journal-link journal-back" href="/blog/">
            <Icon name="arrow" size={16} /> Back to Journal
          </a>
          <div class="journal-article-title">
            <p class="journal-label">{p.category}</p>
            <h1>{p.title}</h1>
            <p class="journal-dek">{p.description}</p>
            <div class="journal-meta journal-byline">
              <a href="/about/">{profile.name}</a>
              <time datetime={p.publishDate.toISOString()}>{dateLabel(p.publishDate)}</time>
              <span>{readingTime(post)} min read</span>
            </div>
          </div>
        </div>
      </header>

      {p.coverImage && (
        <figure class="journal-wrap journal-article-figure">
          <JournalCover cover={p.coverImage} priority />
          {p.coverImage.caption && <figcaption>{p.coverImage.caption}</figcaption>}
        </figure>
      )}

      <div class="journal-wrap journal-reading">
        {sections.length >= 3 && (
          <nav class="journal-contents" aria-label="Table of contents">
            <h2 class="journal-label">On this page</h2>
            <ul>
              {sections.map(({ slug, text }) => <li><a href={`#${slug}`}>{text}</a></li>)}
            </ul>
          </nav>
        )}

        <div class="journal-story">
          {p.takeaways.length > 0 && (
            <section class="journal-takeaways" aria-labelledby="journal-takeaways-heading">
              <h2 id="journal-takeaways-heading">Key takeaways</h2>
              <ul>{p.takeaways.map((item) => <li>{item}</li>)}</ul>
            </section>
          )}
          <div class="journal-body"><Content /></div>

          <div class="journal-story-footer">
            {p.tags.length > 0 && (
              <ul class="journal-tags" aria-label="Article tags">
                {p.tags.map((tag) => <li>{tag}</li>)}
              </ul>
            )}
            <div class="journal-share">
              <a class="journal-link" href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`}>
                Share on LinkedIn <Icon name="diagonal" size={15} />
              </a>
              <button class="journal-copy" type="button" data-article-url={url} hidden>
                <Icon name="link" size={16} /> Copy article link
              </button>
              <span id="journal-copy-status" aria-live="polite"></span>
            </div>
          </div>
        </div>
      </div>
    </article>

    {related.length > 0 && (
      <section class="journal-wrap journal-related" aria-labelledby="journal-related-heading">
        <header class="journal-section-head">
          <h2 id="journal-related-heading">Related articles</h2>
        </header>
        <div class="journal-list">
          {related.map(({ entry }) => <JournalEntry post={entry} />)}
        </div>
      </section>
    )}

    {(newer || older) && (
      <nav class="journal-wrap journal-neighbours" aria-label="More from the Journal">
        {newer && (
          <a rel="prev" href={articleUrl(newer.id)}>
            <span class="journal-label"><Icon name="arrow" size={16} /> Previous article</span>
            <span class="journal-neighbour-title">{newer.data.title}</span>
          </a>
        )}
        {older && (
          <a rel="next" href={articleUrl(older.id)}>
            <span class="journal-label">Next article <Icon name="arrow" size={16} /></span>
            <span class="journal-neighbour-title">{older.data.title}</span>
          </a>
        )}
      </nav>
    )}
  </div>
  <script>
    const copy = document.querySelector<HTMLButtonElement>("[data-article-url]");
    const status = document.querySelector("#journal-copy-status");
    if (copy && navigator.clipboard && status) {
      copy.hidden = false;
      copy.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(copy.dataset.articleUrl!);
          status.textContent = "Link copied.";
        } catch {
          status.textContent = "Copy the address from your browser.";
        }
      });
    }
  </script>
</Base>
