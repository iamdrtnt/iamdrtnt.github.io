---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import Icon from "../components/Icon.astro";
import { profile } from "../data/profile";
---

<Base
  title="Contact and Professional Profiles | Mohammadreza Norouzi"
  description="Find verified public profiles and professional contact information for Mohammadreza Norouzi, a medical graduate based in Vancouver, Canada."
  label="Contact"
>
  <PageHead
    title="Let's Connect."
    parent="Meaningful Connections. Better Healthcare."
    description={"I believe meaningful progress in healthcare begins with exchanging ideas, sharing knowledge, and bringing different perspectives together. I welcome opportunities to connect with researchers, healthcare professionals, entrepreneurs, and organisations working to advance medicine and improve healthcare systems. Whether you're interested in research collaboration, healthcare innovation, startup partnerships, academic opportunities, scientific writing, or exploring new professional possibilities, I'd be glad to connect."}
  />
  <div class="wrap section editorial">
    <aside class="aside-card">
      <Icon name="pin" size={26} />
      <h2>Location</h2>
      <p>{profile.location}</p>
    </aside>
    <div class="prose">
      <h2>Professional profiles</h2>
      <div class="profile-list">
        {profile.profiles.map((p) => (
          <a href={p.url} rel="me">
            <span>{p.label}</span>
            <Icon name="diagonal" size={19} />
          </a>
        ))}
      </div>
      <h2>Email enquiries</h2>
      {profile.email ? (
        <a href={"mailto:" + profile.email}>{profile.email}</a>
      ) : (
        <p>A public email address has not been provided.</p>
      )}
      <p class="note">
        For an overview of my training and research interests, see my{" "}
        <a href="/cv/">curriculum vitae</a>.
      </p>
    </div>
  </div>
</Base>
