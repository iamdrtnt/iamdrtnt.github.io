---
import Icon from "./Icon.astro";
import "../styles/stethoscope.css";
import { localeFromPath, localPath, numberLabel, translator } from "../i18n/locales";

const locale = localeFromPath(Astro.url.pathname);
const t = translator(locale);
const scrollLabel = t("Scroll to explore", "برای دیدن فصل‌ها پیمایش کنید");
const continueLabel = t("Continue to portfolio", "رفتن به سوابق حرفه‌ای");
const figurePrefix = t("Fig.", "شکل");

const chapters = [
  { id: "introduction", label: t("Introduction", "مقدمه"), figure: t("Acoustic stethoscope", "گوشی پزشکی آکوستیک") },
  {
    id: "medicine",
    label: t("Medicine", "پزشکی"),
    figure: t("Chestpiece & diaphragm", "سری گوشی و دیافراگم"),
    first: t("Where Knowledge", "جایی که دانش"),
    last: t("Meets Responsibility.", "با مسئولیت همراه می‌شود."),
    detail:
      t("My journey in medicine has been shaped by frontline clinical practice, where critical thinking, sound judgment, and decisive action are essential.", "مسیر من در پزشکی با کار در خط مقدم مراقبت بالینی شکل گرفته است؛ جایی که تفکر نقادانه، قضاوت سنجیده و اقدام قاطع ضروری‌اند."),
    link: "/experience/",
    action: t("Clinical experience", "تجربهٔ بالینی"),
  },
  {
    id: "research-study",
    label: t("Research", "پژوهش"),
    figure: t("Acoustic pathway", "مسیر انتقال صدا"),
    first: t("Driven by Curiosity.", "با انگیزهٔ کنجکاوی،"),
    last: t("Guided by Evidence.", "با راهنمایی شواهد."),
    detail:
      t("My clinical background has strengthened my interest in connecting real-world healthcare challenges with rigorous research and evidence-based solutions.", "تجربهٔ بالینی علاقه‌ام را به پیوند دادن مسائل واقعی سلامت با پژوهش دقیق و راه‌حل‌های مبتنی بر شواهد پررنگ‌تر کرده است."),
    link: "/research/#publications",
    action: t("Research & publications", "پژوهش و آثار علمی"),
  },
  {
    id: "innovation",
    label: t("Innovation", "نوآوری"),
    figure: t("Binaural assembly", "مجموعهٔ لوله‌های دوگوشی"),
    first: t("Rethinking Healthcare.", "بازنگری در شیوهٔ مراقبت،"),
    last: t("Expanding Access.", "گسترش دسترسی."),
    detail:
      t("I believe that access to timely, high-quality healthcare should not depend on a person's financial circumstances.", "به باور من دسترسی به مراقبت به‌موقع و باکیفیت نباید به توان مالی افراد وابسته باشد."),
    link: "/research/#healthcare-innovation",
    action: t("Healthcare innovation", "نوآوری در سلامت"),
  },
  {
    id: "resolution",
    label: t("Resolution", "جمع‌بندی"),
    figure: t("Assembled instrument", "گوشی پزشکی کامل"),
    first: t("Explore the", "مروری بر"),
    last: t("Portfolio.", "سوابق حرفه‌ای"),
    detail:
      t("Explore my clinical background, research interests, and essays on reading and applying medical evidence.", "با پیشینهٔ بالینی و علایق پژوهشی من آشنا شوید و نوشته‌هایم دربارهٔ خواندن و به‌کارگیری شواهد پزشکی را بخوانید."),
    link: "/blog/",
    action: t("Read the journal", "مطالعهٔ مجله"),
  },
];
const figureNumbers = chapters.map((_, i) => numberLabel(i + 1, locale, 2));
---

<section class="study" data-study data-scroll-label={scrollLabel} data-continue-label={continueLabel} data-figure-prefix={figurePrefix} aria-label={t("A stethoscope in five chapters", "یک گوشی پزشکی در پنج فصل")}>
  <div class="study-stops" aria-hidden="true"></div>
  <div class="study-shell">
    <div class="study-arrangement wrap">
      <div class="study-copy">
        {
          chapters.map((chapter, i) => (
            <section
              class="study-chapter"
              id={chapter.id}
              data-chapter
              data-figure={chapter.figure}
              data-figure-number={figureNumbers[i]}
              aria-labelledby={`${chapter.id}-title`}
            >
              {i === 0 ? (
                <>
                  <p class="study-kicker">
                    <Icon name="brain" size={27} /> {t("From Clinical Practice to New Perspectives", "از طبابت بالینی تا دیدگاه‌های تازه")}
                  </p>
                  <h1 class="study-name" id={`${chapter.id}-title`}>
                    {t("Mohammadreza", "محمدرضا")} <em>{t("Norouzi", "نوروزی")}</em>
                  </h1>
                  <p class="study-identity">
                    <span>{t("International Medical Graduate", "دانش‌آموختهٔ بین‌المللی پزشکی")}</span> <b>|</b>{" "}
                    <span>{t("Research & Healthcare Innovation", "پژوهش و نوآوری در سلامت")}</span>
                  </p>
                  <div class="study-actions">
                    <a class="study-button" href="#portfolio">
                      {t("Explore portfolio", "مرور سوابق حرفه‌ای")} <Icon name="arrow" size={16} />
                    </a>
                    <a class="study-link" href={localPath("/about/", locale)}>
                      {t("About me", "دربارهٔ من")} <Icon name="diagonal" size={14} />
                    </a>
                  </div>
                </>
              ) : (
                <>
                  <p class="study-kicker">
                    <Icon
                      name={["", "activity", "network", "layers", "book"][i]}
                      size={24}
                    />
                    {chapter.label}
                  </p>
                  <h2 class="study-title" id={`${chapter.id}-title`}>
                    {chapter.first} <em>{chapter.last}</em>
                  </h2>
                  <p class="study-description">{chapter.detail}</p>
                  <div class="study-actions">
                    <a class="study-link" href={chapter.link && localPath(chapter.link, locale)}>
                      {chapter.action} <Icon name="diagonal" size={15} />
                    </a>
                    {i === 4 && (
                      <a class="study-link" href="#portfolio">
                        {continueLabel} <Icon name="arrow" size={15} />
                      </a>
                    )}
                  </div>
                </>
              )}
            </section>
          ))
        }
      </div>
      <figure class="study-figure">
        <div class="study-plate">
          <img
            class="study-poster"
            src="/images/stethoscope.webp"
            width="1200"
            height="1000"
            alt={t("A silver and graphite acoustic stethoscope, with a round diaphragm, flexible tubing, and paired metal ear tubes.", "گوشی پزشکی آکوستیک به رنگ نقره‌ای و خاکستری تیره، با دیافراگم گرد، لولهٔ انعطاف‌پذیر و دو لولهٔ فلزی گوش.")}
            fetchpriority="high"
          />
          <canvas data-instrument aria-hidden="true"></canvas>
        </div>
        <figcaption class="study-caption">
          <span class="study-fig-number" data-figure-no>{figurePrefix} {figureNumbers[0]}</span><span
            class="study-caption-rule"
            aria-hidden="true"></span><span data-figure-label
            >{chapters[0].figure}</span
          >
        </figcaption>
      </figure>
    </div>
    <div class="study-footer wrap">
      <a class="study-next" href="#medicine"
        ><span aria-hidden="true">↓</span><span data-next-label
          >{scrollLabel}</span
        ></a
      >
      <nav class="study-nav" aria-label={t("Study chapters", "فصل‌ها")}>
        {
          chapters.map((chapter, i) => (
            <a href={`#${chapter.id}`}>
              <span class="study-step-number" aria-hidden="true">
                {figureNumbers[i]}
              </span>
              {chapter.label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</section>

<script>
  import { startStudy } from "../lib/stethoscope/sequence";
  const study = document.querySelector<HTMLElement>("[data-study]");
  if (study) startStudy(study);
</script>
