---
import { articleUrl, dateLabel, readingLabel, type Article } from "../lib/articles";
import { localeFromPath } from "../i18n/locales";
import { categoryLabel } from "../i18n/categories";
import Icon from "./Icon.astro";
import JournalCover from "./JournalCover.astro";

interface Props {
  post: Article;
}

const { post } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const { category, title, description, publishDate, coverImage } = post.data;
---

<article class="journal-entry" data-journal-category={category}>
  {coverImage && <JournalCover cover={coverImage} />}
  <div class="journal-entry-copy">
    <p class="journal-label">{categoryLabel(category, locale)}</p>
    <h3><a href={articleUrl(post.id, locale)}>{title}</a></h3>
    <p>{description}</p>
  </div>
  <div class="journal-entry-meta journal-meta">
    <time datetime={publishDate.toISOString()}>{dateLabel(publishDate, locale)}</time>
    <span>{readingLabel(post, locale)}</span>
  </div>
  <span class="journal-entry-arrow" aria-hidden="true">
    <Icon name="diagonal" size={18} />
  </span>
</article>
