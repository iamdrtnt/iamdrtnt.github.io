---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { localeFromPath, translator } from "../i18n/locales";

interface Props {
  image: ImageMetadata;
}

const { image } = Astro.props;
const t = translator(localeFromPath(Astro.url.pathname));
---

<about-portrait>
  <figure class="portrait">
    <div class="portrait-light" aria-hidden="true">
      <span class="portrait-halo"></span>
      <span class="portrait-sweep"></span>
    </div>
    <Image
      class="portrait-subject"
      src={image}
      alt={t("Portrait of Mohammadreza Norouzi", "پرترهٔ محمدرضا نوروزی")}
      format="webp"
      quality={84}
      widths={[320, 480, 720, 960, 1120].filter((width) => width <= image.width)}
      sizes="(width < 760px) min(90vw, 20rem), min(30vw, 26rem)"
      loading="eager"
    />
  </figure>
</about-portrait>

<style>
  about-portrait {
    display: block;
    width: min(100%, 26rem);
    margin-block-end: clamp(24px, 2.4vw, 36px);
  }

  .portrait {
    position: relative;
    isolation: isolate;
  }

  .portrait-subject {
    position: relative;
    width: 100%;
    filter: drop-shadow(2px -1px 2px light-dark(#7892a84a, #a4c1df47));
  }

  .portrait-light,
  .portrait-halo,
  .portrait-sweep {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .portrait-light {
    overflow: clip;
    mask-image: linear-gradient(to right, transparent, #000 9%, #000 91%, transparent);
    background: radial-gradient(
      ellipse 46% 43% at 47% 51%,
      light-dark(#474e611f, #080d155c),
      transparent 100%
    );
  }

  .portrait-halo {
    background: radial-gradient(
      ellipse 47% 47% at 61% 46%,
      light-dark(#698cb67a, #5a83b39e),
      transparent 100%
    );
    opacity: 0.72;
  }

  .portrait-sweep {
    background: radial-gradient(
      ellipse 16% 39% at 73% 44%,
      light-dark(#f8fbffd9, #c0d6ec96),
      transparent 100%
    );
    opacity: 0;
    transform: rotate(19deg);
  }

  @media (width < 760px) {
    about-portrait {
      width: min(100%, 20rem);
      margin-inline: auto;
    }
  }
</style>

<script>
  const motionQuery = "(prefers-reduced-motion: no-preference)";

  class AboutPortrait extends HTMLElement {
    #teardown?: () => void;

    connectedCallback() {
      const controller = new AbortController();
      const { signal } = controller;
      const preference = matchMedia(motionQuery);
      let revertMotion: (() => void) | undefined;

      this.#teardown = () => {
        controller.abort();
        revertMotion?.();
      };

      const startMotion = async () => {
        if (!preference.matches) return;
        preference.removeEventListener("change", startMotion);

        try {
          const [{ gsap }, { ScrollTrigger }] = await Promise.all([
            import("gsap"),
            import("gsap/ScrollTrigger"),
          ]);
          if (signal.aborted) return;

          gsap.registerPlugin(ScrollTrigger);
          const media = gsap.matchMedia(this);
          revertMotion = () => media.revert();
          media.add(
            { motion: motionQuery, wide: "(min-width: 760px)" },
            ({ conditions }) => {
              if (!conditions?.motion) return;

              const timeline = gsap.timeline({
                defaults: { ease: "none" },
                scrollTrigger: {
                  trigger: this,
                  start: "clamp(top 95%)",
                  end: "top 24%",
                  scrub: true,
                },
              });
              timeline
                .fromTo(
                  ".portrait-subject",
                  { y: 14 },
                  { y: 0, duration: 0.64, ease: "sine.out" },
                  0,
                )
                .fromTo(
                  ".portrait-halo",
                  { opacity: 0.18, xPercent: -11, yPercent: 5 },
                  { opacity: 1, xPercent: 12, yPercent: -3, duration: 0.54 },
                  0,
                )
                .fromTo(
                  ".portrait-sweep",
                  { xPercent: -24, yPercent: 9 },
                  { xPercent: 17, yPercent: -5, duration: 0.82 },
                  0.18,
                )
                .fromTo(
                  ".portrait-sweep",
                  { opacity: 0 },
                  { opacity: conditions.wide ? 0.9 : 0.55, duration: 0.37 },
                  0.18,
                )
                .to(".portrait-sweep", { opacity: 0, duration: 0.45 }, 0.55)
                .to(
                  ".portrait-halo",
                  { opacity: 0.72, xPercent: 0, yPercent: 0, duration: 0.46 },
                  0.54,
                );
            },
          );
        } catch {
          // A failed enhancement leaves the static figure available.
          revertMotion?.();
        }
      };

      preference.addEventListener("change", startMotion, { signal });
      window.addEventListener(
        "pagehide",
        (event) => {
          if (!event.persisted) this.#teardown?.();
        },
        { signal },
      );
      void startMotion();
    }

    disconnectedCallback() {
      this.#teardown?.();
      this.#teardown = undefined;
    }
  }

  customElements.define("about-portrait", AboutPortrait);
</script>
