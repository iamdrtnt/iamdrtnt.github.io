---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  image: ImageMetadata;
}

const { image } = Astro.props;
---

<about-portrait>
  <figure class="portrait">
    <span class="portrait-orbit" aria-hidden="true"></span>
    <div class="portrait-surface">
      <Image
        src={image}
        alt="Portrait of Mohammadreza Norouzi"
        format="webp"
        quality={84}
        widths={[320, 480, 720, 960, 1120].filter((width) => width <= image.width)}
        sizes="(width < 760px) min(90vw, 22rem), min(30vw, 26rem)"
        loading="eager"
      />
      <span class="portrait-shade" aria-hidden="true"></span>
      <span class="portrait-sweep" aria-hidden="true"></span>
      <span class="portrait-rim" aria-hidden="true"></span>
    </div>
  </figure>
</about-portrait>

<style>
  about-portrait {
    display: block;
    width: min(100%, 26rem);
    margin-block-end: clamp(32px, 3.2vw, 48px);
  }

  .portrait {
    position: relative;
    isolation: isolate;
  }

  .portrait-surface {
    position: relative;
    overflow: hidden;
    border-radius: 3px;
    background: var(--black);
  }

  .portrait-surface img {
    width: 100%;
  }

  .portrait-orbit,
  .portrait-shade,
  .portrait-sweep,
  .portrait-rim {
    position: absolute;
    pointer-events: none;
  }

  .portrait-orbit {
    inset: 7% -17px 10%;
    border: 1px solid transparent;
    border-block-start-color: color-mix(in srgb, var(--muted) 34%, transparent);
    border-inline-end-color: color-mix(in srgb, var(--accent) 24%, transparent);
    border-radius: 50%;
    transform: rotate(-12deg);
  }

  .portrait-shade,
  .portrait-sweep,
  .portrait-rim {
    inset: 0;
  }

  .portrait-shade {
    background: linear-gradient(138deg, #14171d, #080a0d 78%);
    opacity: 0;
  }

  .portrait-sweep {
    background: linear-gradient(
      113deg,
      transparent 25%,
      rgb(174 195 218 / 0.1) 44%,
      rgb(226 235 244 / 0.19) 52%,
      transparent 72%
    );
    /* Keep the moving highlight strongest near the photographic edges. */
    mask-image: linear-gradient(#000, #0005 25%, #0003 59%, #000 100%);
    opacity: 0;
  }

  .portrait-rim {
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgb(177 198 222 / 0.46);
    opacity: 0.42;
  }

  @media (width < 760px) {
    about-portrait {
      width: min(100%, 22rem);
      margin-inline: auto;
    }

    .portrait-orbit {
      display: none;
    }
  }
</style>

<script>
  const motionQuery = "(prefers-reduced-motion: no-preference)";

  class AboutPortrait extends HTMLElement {
    #teardown?: () => void;

    connectedCallback() {
      const controller = new AbortController();
      const { signal } = controller;
      const preference = matchMedia(motionQuery);
      let revertMotion: (() => void) | undefined;

      this.#teardown = () => {
        controller.abort();
        revertMotion?.();
      };

      const startMotion = async () => {
        if (!preference.matches) return;
        preference.removeEventListener("change", startMotion);

        try {
          const [{ gsap }, { ScrollTrigger }] = await Promise.all([
            import("gsap"),
            import("gsap/ScrollTrigger"),
          ]);
          if (signal.aborted) return;

          gsap.registerPlugin(ScrollTrigger);
          const media = gsap.matchMedia(this);
          revertMotion = () => media.revert();
          media.add(
            { motion: motionQuery, wide: "(min-width: 760px)" },
            ({ conditions }) => {
              if (!conditions?.motion) return;

              const timeline = gsap.timeline({
                defaults: { ease: "none" },
                scrollTrigger: {
                  trigger: this,
                  start: "clamp(top 95%)",
                  end: "top 24%",
                  scrub: true,
                },
              });
              timeline
                .fromTo(
                  ".portrait-surface",
                  { y: 20, opacity: 0.96 },
                  { y: 0, opacity: 1, duration: 0.42, ease: "sine.out" },
                  0,
                )
                .fromTo(
                  ".portrait-shade",
                  { opacity: 0.19 },
                  { opacity: 0, duration: 0.44 },
                  0,
                )
                .fromTo(
                  ".portrait-sweep",
                  { xPercent: -72 },
                  { xPercent: 72, duration: 0.82 },
                  0.18,
                )
                .fromTo(
                  ".portrait-sweep",
                  { opacity: 0 },
                  { opacity: conditions.wide ? 0.9 : 0.55, duration: 0.37 },
                  0.18,
                )
                .to(".portrait-sweep", { opacity: 0, duration: 0.45 }, 0.55)
                .to(".portrait-rim", { opacity: 0.82, duration: 0.37 }, 0.18)
                .to(".portrait-rim", { opacity: 0.42, duration: 0.45 }, 0.55);

              if (conditions.wide) {
                timeline.from(".portrait-orbit", { rotation: -17, duration: 1 }, 0);
              }
            },
          );
        } catch {
          // A failed enhancement leaves the static figure available.
          revertMotion?.();
        }
      };

      preference.addEventListener("change", startMotion, { signal });
      window.addEventListener(
        "pagehide",
        (event) => {
          if (!event.persisted) this.#teardown?.();
        },
        { signal },
      );
      void startMotion();
    }

    disconnectedCallback() {
      this.#teardown?.();
      this.#teardown = undefined;
    }
  }

  customElements.define("about-portrait", AboutPortrait);
</script>
