---
interface Props {
  items: { title: string; detail: string; label?: string }[];
}
const { items } = Astro.props;
---

<ol class="timeline">
  {items.map((item) => (
    <li>
      {item.label && <p class="kicker">{item.label}</p>}
      <h3>{item.title}</h3>
      <p>{item.detail}</p>
    </li>
  ))}
</ol>
