---
import type { CollectionEntry } from "astro:content";
import { articleUrl, dateLabel, readingTime } from "../lib/articles";
import Icon from "./Icon.astro";
interface Props {
  post: CollectionEntry<"blog">;
}
const { post } = Astro.props;
---

<article class="article-card" data-category={post.data.category}>
  <p class="kicker">{post.data.category}</p>
  <h3>
    <a href={articleUrl(post.id)}>{post.data.title}</a>
  </h3>
  <p>{post.data.description}</p>
  <div class="card-bottom">
    <span>
      <time datetime={post.data.date.toISOString()}>
        {dateLabel(post.data.date)}
      </time>{" "}
      · {readingTime(post)} min read
    </span>
    <Icon name="arrow" size={18} />
  </div>
</article>
