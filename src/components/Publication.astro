---
import type { Publication } from "../data/profile";
import { localeFromPath, numberLabel, translator } from "../i18n/locales";
interface Props {
  record: Publication;
}
const { record: p } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const t = translator(locale);
---

<article class="record">
  <p class="kicker">
    {p.type} · {numberLabel(p.year, locale)}
  </p>
  <h3>{p.title}</h3>
  <p>
    {p.authors.join(", ")}. <em>{p.journal}</em>.
  </p>
  {p.abstract && <p>{p.abstract}</p>}
  <div class="inline-links">
    {p.doi && <a href={"https://doi.org/" + p.doi}><bdi dir="ltr">DOI {p.doi}</bdi></a>}
    {p.url && <a href={p.url}>{t("Publication record", "رکورد اثر علمی")}</a>}
    {p.pubmed && <a href={p.pubmed}>{t("PubMed record", "رکورد در PubMed")}</a>}
  </div>
</article>
