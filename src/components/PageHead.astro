---
import { localeFromPath, translator } from "../i18n/locales";

interface Props {
  title: string;
  description: string;
  parent?: string;
}
const t = translator(localeFromPath(Astro.url.pathname));
const { title, description, parent = t("Academic portfolio", "سوابق علمی و حرفه‌ای") } = Astro.props;
---

<div class="page-head">
  <div class="wrap">
    <p class="eyebrow">
      <span></span>
      {parent}
    </p>
    <h1>{title}</h1>
    <p class="lead">{description}</p>
  </div>
</div>
