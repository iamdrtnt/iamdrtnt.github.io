---
interface Props {
  sections?: boolean;
}
const { sections = false } = Astro.props;
---

<figure class:list={["plate", { "section-plate": sections }]}>
  <div class="instrument">
    <svg class="graticule" viewBox="0 0 600 550" fill="none" aria-hidden="true">
      <g stroke="currentColor">
        <circle cx="300" cy="275" r="233" stroke-dasharray="1 9" />
        <circle cx="300" cy="275" r="222" opacity=".68" />
        <path d="M36 275h528M300 29v492" stroke-dasharray="3 7" opacity=".58" />
        {Array.from({ length: 72 }, (_, i) => (
          <path
            d={i % 6 ? "M300 42v4" : "M300 39v10"}
            transform={`rotate(${i * 5} 300 275)`}
          />
        ))}
        <path d="M9 43h10m-5-5v10m568 459h10m-5-5v10" />
      </g>
    </svg>
    <div class="specimen">
      {sections ? (
        <div
          class="laminae"
          role="img"
          aria-label="The left cerebral hemisphere shown in three separated sections of the reference surface."
        >
          {["Anterior", "Middle", "Posterior"].map((part) => (
            <i aria-hidden="true">
              <img
                src="/images/cortex-sections.webp"
                width="840"
                height="2016"
                loading="lazy"
                decoding="async"
                alt={part + " section of the reference cortical surface."}
              />
            </i>
          ))}
        </div>
      ) : (
        <img
          src="/images/cortex-study-1120.webp"
          srcset="/images/cortex-study-600.webp 600w, /images/cortex-study-1120.webp 1120w"
          sizes="(max-width: 759px) 93vw, (max-width: 1050px) and (orientation: portrait) 72vw, 49vw"
          width="1120"
          height="896"
          fetchpriority="high"
          alt="Silver contour lines trace the folds of the left cerebral hemisphere in lateral view."
        />
      )}
    </div>
    <span class="plate-callout" aria-hidden="true">
      {sections ? "Surface sections" : "Left hemisphere"}
    </span>
  </div>
  <figcaption>
    <span>
      <b>Fig. {sections ? "02" : "01"}</b> / Cerebral cortex
    </span>
    <span>{sections ? "Section study" : "Lateral view"}</span>
  </figcaption>
</figure>
