---
import "../styles/site.css";
import displayFont from "@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url";
import bodyFont from "@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url";
import { profile as approvedProfile } from "../data/profile";
import { navigationFor, profileFor } from "../i18n/profile";
import { englishPath, localeFromPath, locales, localPath, translator } from "../i18n/locales";
import "../i18n/rtl.css";
import Icon from "../components/Icon.astro";
interface Props {
  title: string;
  description: string;
  label?: string;
  type?: string;
  extraSchema?: Record<string, unknown>;
  noindex?: boolean;
  date?: Date;
  image?: string;
  imageAlt?: string;
  paired?: boolean;
  fragments?: Record<string, string>;
}
const {
  title,
  description,
  label,
  type = "WebPage",
  extraSchema = {},
  noindex = false,
  date,
  image = "/images/social-card.png",
  imageAlt,
  paired = true,
  fragments,
} = Astro.props;
const base = Astro.site!;
const absolute = (path: string) => new URL(path, base).href;
const path = Astro.url.pathname;
const url = absolute(path);
const locale = localeFromPath(path);
const otherLocale = locale === "fa" ? "en" : "fa";
const settings = locales[locale];
const t = translator(locale);
const profile = profileFor(locale);
const route = (value: string) => localPath(value, locale);
const sourcePath = englishPath(path);
const home = sourcePath === "/";
const englishSwitch = sourcePath === "/404/" ? "/404.html" : sourcePath;
const rss = route("/rss.xml");
const alternates = {
  en: sourcePath,
  fa: localPath(sourcePath, "fa"),
};
const homeLabel = t("Home", "خانه");
const journalLabel = t("Journal", "مجله");
const person = {
  "@type": "Person",
  "@id": absolute("/#person"),
  name: profile.name,
  ...(locale === "fa" ? { alternateName: approvedProfile.name } : {}),
  url: absolute(route("/about/")),
  sameAs: profile.profiles.map((p) => p.url),
  homeLocation: { "@type": "Place", name: profile.location },
};
const website = {
  "@type": "WebSite",
  "@id": absolute(route("/") + "#website"),
  url: absolute(route("/")),
  name: profile.name,
  inLanguage: settings.lang,
};
const crumbs = [
  { name: homeLabel, item: absolute(route("/")) },
  ...(type === "BlogPosting"
    ? [{ name: journalLabel, item: absolute(route("/blog/")) }]
    : []),
  { name: label || title, item: url },
];
const graph = [
  person,
  website,
  {
    "@type": type,
    "@id": url + "#page",
    url,
    name: title,
    description,
    inLanguage: settings.lang,
    isPartOf: { "@id": website["@id"] },
    ...(type === "ProfilePage" ? { mainEntity: { "@id": person["@id"] } } : {}),
    ...extraSchema,
  },
  ...(!home
    ? [
        {
          "@type": "BreadcrumbList",
          itemListElement: crumbs.map((v, i) => ({
            "@type": "ListItem",
            position: i + 1,
            ...v,
          })),
        },
      ]
    : []),
];
---

<!doctype html>
<html lang={settings.lang} dir={settings.dir}>
  <head>
    <meta charset="utf-8" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
      href={displayFont}
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
      href={locale === "fa" ? "/fonts/vazirmatn-arabic.woff2" : bodyFont}
    />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    {paired && !noindex && (
      <>
        <link rel="alternate" hreflang={locales.en.lang} href={absolute(alternates.en)} />
        <link rel="alternate" hreflang={locales.fa.lang} href={absolute(alternates.fa)} />
        <link rel="alternate" hreflang="x-default" href={absolute(alternates.en)} />
        <meta property="og:locale:alternate" content={locales[otherLocale].og} />
      </>
    )}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta
      property="og:type"
      content={type === "BlogPosting" ? "article" : "website"}
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content={settings.og} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:image" content={absolute(image)} />
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absolute(image)} />
    {imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
    {date && (
      <meta property="article:published_time" content={date.toISOString()} />
    )}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={t("Mohammadreza Norouzi’s blog", "مجلهٔ محمدرضا نوروزی")}
      href={rss}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@graph": graph,
      }).replace(/</g, "\\u003c")}
    />
    <script is:inline>
      try {
        const theme = localStorage.getItem("theme");
        if (theme === "dark" || theme === "light")
          document.documentElement.dataset.theme = theme;
      } catch {}
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <a class="skip" href="#main">
      {t("Skip to content", "رفتن به محتوای اصلی")}
    </a>
    <header class="mast">
      <div class="wrap bar">
        <a class="brand" href={route("/")} aria-label={t("Mohammadreza Norouzi, home", "محمدرضا نوروزی، خانه")}>
          <span class="monogram" aria-hidden="true">mn<span>.</span></span>
          <span class="brand-name">{profile.name}</span>
        </a>
        <nav id="navigation" aria-label={t("Main navigation", "ناوبری اصلی")}>
          {navigationFor(locale).map(({ label, path: original, href }) => (
            <a
              href={href}
              aria-current={path === href ? "page" : undefined}
              class:list={[path.startsWith(href) && original !== "/" && "ancestor", original === "/contact/" && "contact-nav"]}
            >
              {label}{original === "/contact/" && <Icon name="diagonal" size={13} />}
            </a>
          ))}
        </nav>
        <div class="controls">
          {paired && (
            <div class="locale-switch" dir="ltr" role="group" aria-label={t("Language", "زبان")}>
              <a href={englishSwitch} hreflang="en-CA" aria-label={t("English", "انگلیسی")} aria-current={locale === "en" ? "true" : undefined} data-base={englishSwitch} data-fragments={locale === "fa" && fragments ? JSON.stringify(fragments) : undefined}>EN</a>
              <span aria-hidden="true">/</span>
              <a href={alternates.fa} hreflang="fa-IR" aria-label={t("Persian", "فارسی")} aria-current={locale === "fa" ? "true" : undefined} data-base={alternates.fa} data-fragments={locale === "en" && fragments ? JSON.stringify(fragments) : undefined}>FA</a>
            </div>
          )}
          <button
            class="iconbtn theme"
            aria-label={t("Dark theme", "پوستهٔ تیره")}
            aria-pressed="false"
            title={t("Toggle dark theme", "تغییر پوستهٔ تیره")}
          >
            <span class="day">
              <Icon name="moon" />
            </span>
            <span class="night">
              <Icon name="sun" />
            </span>
          </button>
          <button
            class="iconbtn menu"
            aria-expanded="false"
            aria-controls="navigation"
            aria-label={t("Navigation menu", "منوی ناوبری")}
          >
            <Icon name="menu" />
          </button>
        </div>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer>
      <div class="wrap footer-row">
        <div>
          <a class="foot-name" href={route("/")}>
            {profile.name}
          </a>
          <p>{profile.location}</p>
        </div>
        <div class="footer-links">
          <a href={route("/cv/")}>{t("Curriculum vitae", "رزومه")}</a>
          <a href={route("/contact/")}>{t("Contact", "تماس")}</a>
          <a href={rss}>{t("RSS feed", "خوراک RSS")}</a>
        </div>
      </div>
    </footer>
    <script>
      const switchLinks = document.querySelectorAll<HTMLAnchorElement>(".locale-switch a");
      const updateLanguageLinks = () => {
        let fragment = "";
        try {
          fragment = decodeURIComponent(location.hash.slice(1));
        } catch {
          // An invalid escape cannot identify a section.
        }
        for (const link of switchLinks) {
          const map: Record<string, string> | undefined = link.dataset.fragments
            ? JSON.parse(link.dataset.fragments)
            : undefined;
          const matchingFragment = fragment && document.getElementById(fragment) ? fragment : "";
          const target = map && matchingFragment
            ? (Object.hasOwn(map, matchingFragment) ? map[matchingFragment] : "")
            : matchingFragment;
          link.href = link.dataset.base! + (target ? "#" + encodeURIComponent(target) : "");
        }
      };
      updateLanguageLinks();
      window.addEventListener("hashchange", updateLanguageLinks);

      const root = document.documentElement;
      const toggle = document.querySelector<HTMLButtonElement>(".theme")!;
      const pref = matchMedia("(prefers-color-scheme: dark)");
      const current = () =>
        root.dataset.theme || (pref.matches ? "dark" : "light");
      function sync() {
        toggle.setAttribute("aria-pressed", String(current() === "dark"));
      }
      sync();
      pref.addEventListener("change", sync);
      toggle.addEventListener("click", () => {
        root.dataset.theme = current() === "dark" ? "light" : "dark";
        try {
          localStorage.setItem("theme", root.dataset.theme);
        } catch {}
        sync();
      });
      const menu = document.querySelector<HTMLButtonElement>(".menu")!;
      const nav = document.querySelector<HTMLElement>("#navigation")!;
      function open(value: boolean) {
        menu.setAttribute("aria-expanded", String(value));
        nav.classList.toggle("open", value);
        if (value) nav.querySelector("a")?.focus();
      }
      menu.addEventListener("click", () =>
        open(menu.getAttribute("aria-expanded") !== "true"),
      );
      document.addEventListener("keydown", (e) => {
        if (
          e.key === "Escape" &&
          menu.getAttribute("aria-expanded") === "true"
        ) {
          open(false);
          menu.focus();
        }
      });
      document.addEventListener("click", (e) => {
        if (e.target instanceof Element && !e.target.closest(".mast"))
          open(false);
      });
    </script>
  </body>
</html>
